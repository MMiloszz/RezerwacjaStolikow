<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>Stoliki</title>
</head>
<body>

    <p>
    <a href="/dashboard">← Powrót do panelu</a> | 
    <a href="/reservations">Moje rezerwacje</a>
    </p>

    <h1>Lista stolików</h1>

    <form action="/tables/add" method="POST">
        <div>
            <label>Numer stolika:</label>
            <input type="number" name="table_number" min="1" required>
        </div>

        <br>

        <div>
            <label>Liczba miejsc:</label>
            <input type="number" name="seats" min="1" required>
        </div>

        <br>

        <button type="submit">Dodaj stolik</button>
    </form>

    <hr>

    <h2>Wszystkie stoliki</h2>

    <% if (tables.length === 0) { %>
        <p>Brak stolików.</p>
    <% } %>

   <% tables.forEach(table => { %>
    <div>
        ID: <%= table.id %>
| Stolik nr <%= table.table_number %>
| Miejsca: <%= table.seats %>
        <a href="/tables/edit/<%= table.id %>">
            Edytuj
            </a>

        |
        <a
        href="/tables/delete/<%= table.id %>"
        onclick="return confirm('Czy na pewno usunąć stolik?')"
        >
        Usuń
        </a>
    </div>
<% }); %>

</body>
</html>