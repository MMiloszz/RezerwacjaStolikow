<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edycja stolika</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="page-layout">
        <header class="page-header">
            <a class="brand" href="/dashboard">Rezerwacja Stolika</a>
            <nav class="main-nav">
                <a class="button ghost" href="/tables">Powrót do stolików</a>
                <a class="button ghost" href="/reservations">Rezerwacje</a>
            </nav>
        </header>
        <main class="content">
            <div class="container">
                <div class="card">
                    <h1>Edycja stolika</h1>
                    <p class="small-note">Aktualizuj dane stolika przed zapisaniem zmian.</p>

                    <form action="/tables/update/<%= table.id %>" method="POST" class="form-grid">
                        <label>
                            Numer stolika
                            <input type="number" name="table_number" value="<%= table.table_number %>" min="1" required>
                        </label>

                        <label>
                            Liczba miejsc
                            <input type="number" name="seats" value="<%= table.seats %>" min="1" required>
                        </label>

                        <button class="button primary" type="submit">Zapisz zmiany</button>
                    </form>
                </div>
            </div>
        </main>
    </div>
</body>
</html>